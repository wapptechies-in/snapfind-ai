{
  "name": "snapfind-ai",
  "version": "0.1.0",
  "private": true,
  "description": "SnapFind AI — Scan. Find. Relive. Monorepo for photographer website, SnapFind web app, desktop app, and shared packages.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "desktop"
  ],
  "scripts": {
    "dev:website": "npm run dev --workspace=apps/photographer-website",
    "dev:web": "npm run dev --workspace=apps/snapfind-web",
    "dev:desktop": "npm run dev --workspace=desktop",
    "build:website": "npm run build --workspace=apps/photographer-website",
    "build:web": "npm run build --workspace=apps/snapfind-web",
    "build:desktop": "npm run build --workspace=desktop",
    "build": "npm run build:website && npm run build:web && npm run build:desktop",
    "install:all": "npm install"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
