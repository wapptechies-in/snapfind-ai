# ==========================================================
# SnapFind AI — Photographer Portfolio & Booking Site (.env)
# Copy to .env or configure in Vercel / Netlify dashboard
# ==========================================================

# Backend API Base URL
VITE_API_URL=https://api.yourdomain.com
VITE_API_BASE_URL=https://api.yourdomain.com

# WebSocket Server URL
VITE_WS_URL=wss://api.yourdomain.com/ws

# Google Identity Services (GIS) OAuth 2.0 Web Client ID
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Portfolio Branding & Info
VITE_SITE_NAME="Apex Photography Studio"
VITE_PHOTOGRAPHER_EMAIL="contact@apexstudio.com"
VITE_PHOTOGRAPHER_PHONE="+1 (555) 019-2834"

