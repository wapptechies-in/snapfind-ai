# ====================================================
# SnapFind AI — Studio Web App Environment Variables
# Copy to .env or configure in Vercel / Netlify dashboard
# ====================================================

# Backend API Base URL (Render / Railway / VPS URL without trailing slash)
VITE_API_URL=https://api.yourdomain.com
VITE_API_BASE_URL=https://api.yourdomain.com

# WebSocket Server URL for live upload progress & notifications
VITE_WS_URL=wss://api.yourdomain.com/ws

# Google Identity Services (GIS) OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console > Credentials > OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Studio Branding
VITE_APP_TITLE="SnapFind AI Studio"

