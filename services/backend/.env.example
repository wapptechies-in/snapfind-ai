# ============================================
# SnapFind AI — Backend Configuration (.env)
# ============================================

# General & Environment
APP_NAME="SnapFind AI API"
ENVIRONMENT=production
SEED_DEV_DATA=false

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
PORT=8000

# Database Connection (PostgreSQL 16 with pgvector)
# Supabase / Render / Neon format:
DATABASE_URL=postgresql+psycopg://postgres:your_password@db.your_supabase_ref.supabase.co:5432/postgres

# Security & Authentication
# Generate strong secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_secure_random_64_character_hex_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
SUPERADMIN_EMAIL=admin@yourdomain.com

# CORS Configuration (Comma-separated allowed origins without trailing slashes)
CORS_ORIGINS=https://studio.yourdomain.com,https://yourdomain.com,https://api.yourdomain.com

# Cloud Object Storage (r2, s3, or minio)
STORAGE_PROVIDER=r2
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_r2_account_id
STORAGE_ACCESS_KEY=your_r2_or_s3_access_key_id
STORAGE_SECRET_KEY=your_r2_or_s3_secret_access_key
STORAGE_BUCKET_NAME=snapfind-photos
STORAGE_REGION=auto
STORAGE_CDN_URL=https://cdn.yourdomain.com
MAX_UPLOAD_SIZE_MB=50
PRESIGNED_URL_EXPIRE_SECONDS=3600

# AI InsightFace Vector Engine
AI_MODEL_NAME=insightface
AI_MODEL_VERSION=buffalo_s
FACE_EMBEDDING_DIMENSION=512
FACE_DETECTION_THRESHOLD=0.55
MIN_FACE_SIZE=25
MAX_BLUR_THRESHOLD=10.0
STRONG_MATCH_THRESHOLD=0.50
POSSIBLE_MATCH_THRESHOLD=0.32
TOP_K=500

# Redis & Celery Background Queue
REDIS_URL=redis://:your_redis_password@redis_host:6379/0
CELERY_BROKER_URL=redis://:your_redis_password@redis_host:6379/0
CELERY_RESULT_BACKEND=redis://:your_redis_password@redis_host:6379/1
CELERY_WORKER_CONCURRENCY=2

# WhatsApp & Notifications
FRONTEND_BASE_URL=https://studio.yourdomain.com
WHATSAPP_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=

