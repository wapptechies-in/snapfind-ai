# ============================================
# SnapFind AI — Environment Variables (example)
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================

# --- Backend (services/backend) ---
DATABASE_URL=postgresql://snapfind_user:snapfind_password@localhost:54320/snapfind_ai
SECRET_KEY=dev-secret-key-change-in-production
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,null

# --- SnapFind Web (apps/snapfind-web) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Google OAuth (Backend) ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Photographer Website (apps/photographer-website) ---
VITE_SITE_NAME=SnapFind AI Photography

# --- Cloud Photo Storage (Phase 6) ---
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=snapfind-photos
STORAGE_REGION=us-east-1
MAX_UPLOAD_SIZE_MB=50

# --- Background Processing (Phase 7) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_WORKER_CONCURRENCY=4
JOB_STALE_TIMEOUT_MINUTES=30
THUMBNAIL_MAX_WIDTH=400
THUMBNAIL_MAX_HEIGHT=400
WEB_IMAGE_MAX_WIDTH=1920
WEB_IMAGE_MAX_HEIGHT=1920
WEB_IMAGE_QUALITY=85

# --- AI service (services/ai-service — PLANNED) ---
AI_SERVICE_URL=
