# ==========================================================
# SnapFind AI — Root Monorepo Configuration Template
# ==========================================================

# Environment Mode: development | staging | production
ENVIRONMENT=production

# Server & Domain Configuration
PORTFOLIO_DOMAIN=yourdomain.com
STUDIO_DOMAIN=studio.yourdomain.com
API_DOMAIN=api.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=generate_a_secure_random_64_character_hex_key_here
SUPERADMIN_EMAIL=admin@yourdomain.com

# PostgreSQL 16 + pgvector Database
POSTGRES_USER=snapfind_user
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here
POSTGRES_DB=snapfind_ai
DATABASE_URL=postgresql+psycopg://snapfind_user:generate_a_secure_postgres_password_here@postgres:5432/snapfind_ai

# Redis 7 Cache & Queue
REDIS_PASSWORD=generate_a_secure_redis_password_here
REDIS_URL=redis://:generate_a_secure_redis_password_here@redis:6379/0
CELERY_BROKER_URL=redis://:generate_a_secure_redis_password_here@redis:6379/0
CELERY_RESULT_BACKEND=redis://:generate_a_secure_redis_password_here@redis:6379/1
CELERY_CONCURRENCY=2

# Cloudflare R2 / AWS S3 Object Storage
STORAGE_PROVIDER=r2
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_r2_account_id
STORAGE_ACCESS_KEY=your_r2_or_s3_access_key_id
STORAGE_SECRET_KEY=your_r2_or_s3_secret_access_key
STORAGE_BUCKET_NAME=snapfind-photos
STORAGE_REGION=auto
STORAGE_CDN_URL=https://cdn.yourdomain.com
MAX_UPLOAD_SIZE_MB=50

# Web Application Environment
VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_URL=https://api.yourdomain.com
VITE_WS_URL=wss://api.yourdomain.com/ws
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_SITE_NAME="SnapFind AI Photography"
