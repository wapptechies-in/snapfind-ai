# =================================================================
# SnapFind AI — Production Environment Configuration Template
# Copy this file to .env.production on your production server:
# cp .env.production.example .env.production
# =================================================================

# --- 1. Domain & SSL / TLS Configuration ---
# Your root portfolio domain (e.g. yourstudio.com)
PORTFOLIO_DOMAIN=snapfind.ai

# Photographer Studio Portal & Customer Galleries
STUDIO_DOMAIN=studio.snapfind.ai

# Backend REST API
API_DOMAIN=api.snapfind.ai

# Email address for Let's Encrypt SSL certificate issuance and expiry notices
ACME_EMAIL=admin@yourstudio.com


# --- 2. Security & Application Secrets ---
# Generate a secure 64-char key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_super_secure_random_64_character_hex_secret
ENVIRONMENT=production


# --- 3. Managed PostgreSQL 16 with pgvector ---
POSTGRES_USER=snapfind_user
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password_2026
POSTGRES_DB=snapfind_ai


# --- 4. Managed Redis 7 Broker ---
REDIS_PASSWORD=replace_with_a_secure_redis_password_2026
CELERY_CONCURRENCY=4


# --- 5. Cloud Object Storage & CDN Distribution ---
# Choose your storage provider: 's3', 'r2', or 'minio'
STORAGE_PROVIDER=s3
STORAGE_BUCKET_NAME=snapfind-production-photos
STORAGE_REGION=us-east-1

# --- Option A: AWS S3 + CloudFront CDN (Enterprise Standard) ---
# When using AWS S3, leave STORAGE_ENDPOINT_URL blank.
# STORAGE_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# STORAGE_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# STORAGE_CDN_URL=https://d111111abcdef8.cloudfront.net

# --- Option B: Cloudflare R2 + Cloudflare CDN ($0 Egress Fees Recommended) ---
# STORAGE_PROVIDER=r2
# CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
# STORAGE_ENDPOINT_URL=https://your_cloudflare_account_id.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=your_r2_access_key_id
# STORAGE_SECRET_KEY=your_r2_secret_access_key
# STORAGE_CDN_URL=https://cdn.yourstudio.com

# --- Option C: Self-Hosted MinIO (On-Premise / Single Server VPS) ---
# STORAGE_PROVIDER=minio
# STORAGE_ENDPOINT_URL=http://minio:9000
# STORAGE_PUBLIC_ENDPOINT_URL=https://s3.yourstudio.com
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadminpassword_secure

